# Postgres warehouse (Neon). Used by app.py, scraper.py and dbt (transformation/profiles.yml)
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=litroph_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# Map + routing APIs used by app.py
TOMTOM_API_KEY=your_tomtom_key_here
STADIA_API_KEY=your_stadia_key_here
